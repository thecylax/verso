# Desenvolvimento com PostgreSQL do Compose
DATABASE_URL=postgresql+psycopg://verso:verso@postgres:5432/verso

# Em produção, substitua por uma conexão ao PostgreSQL externo:
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@168.75.95.7:5432/verso

# false em local; true atrás de HTTPS
COOKIE_SECURE=false

# Provedor compatível com a ABíbliaDigital, sem barra no fim
BIBLE_API_BASE_URL=https://abibliadigital.api.br/api

# Bearer do provedor. Vazio desliga a captura de texto na criação da nota.
BIBLE_API_TOKEN=

# Produção com Traefik
VERSO_DOMAIN=verso.blacktomato.vps-kinghost.net
TRAEFIK_NETWORK=portainer_default
TRAEFIK_CERTRESOLVER=leresolver
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure

# Segredo de uso único para criar a primeira conta. Gere um valor aleatório forte.
BOOTSTRAP_SECRET=
