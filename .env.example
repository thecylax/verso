# Conexão SQLAlchemy com o PostgreSQL do Compose
DATABASE_URL=postgresql+psycopg://verso:verso@postgres:5432/verso

# false em local; true atrás de HTTPS
COOKIE_SECURE=false

# Provedor compatível com a ABíbliaDigital, sem barra no fim
BIBLE_API_BASE_URL=https://abibliadigital.api.br/api

# Bearer do provedor. Vazio desliga a captura de texto na criação da nota.
BIBLE_API_TOKEN=
