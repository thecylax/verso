{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API: FastAPI (SQLite local)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}/apps/api",
            "envFile": "${workspaceFolder}/apps/api/.env",
            "module": "uvicorn",
            "args": ["app.main:app", "--port", "8000"],
            "justMyCode": true
        },
        {
            "name": "API: pytest",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}/apps/api",
            "envFile": "${workspaceFolder}/apps/api/.env",
            "module": "pytest",
            "args": ["-q"],
            "justMyCode": false
        }
    ]
}
