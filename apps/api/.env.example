# Execução local, fora do Docker, com SQLite. Copie para apps/api/.env.
# Caminho relativo a apps/api, onde o uvicorn e o alembic rodam.
DATABASE_URL=sqlite:///./verso.db

COOKIE_SECURE=false

BIBLE_API_BASE_URL=https://abibliadigital.api.br/api

# Bearer do provedor. Vazio desliga a captura de texto na criação da nota.
BIBLE_API_TOKEN=
